{
  "name": "overlap",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "firebase": "^13.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "emulators": "npm --prefix functions run build && firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "lint": "expo lint",
    "functions:watch": "npm --prefix functions run build:watch",
    "seed": "node scripts/seed-emulator.ts",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore,storage --project demo-overlap-rules \"node --test tests/rules/\"",
    "export-events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-events.ts",
    "funnel": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/funnel.ts",
    "delete-test-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/delete-test-data.ts",
    "deploy": "firebase deploy --project prod --only firestore,storage,functions",
    "publish": "npx eas-cli update --channel production --environment production --clear-cache"
  },
  "private": true
}
