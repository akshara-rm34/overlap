{
  "name": "overlap",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "firebase": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "emulators": "npm --prefix functions run build && firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "lint": "expo lint",
    "functions:watch": "npm --prefix functions run build:watch",
    "seed": "node scripts/seed-emulator.ts",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore,storage --project demo-overlap-rules \"node --test tests/rules/\"",
    "export-events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-events.ts",
    "funnel": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/funnel.ts",
    "delete-test-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/delete-test-data.ts",
    "deploy": "firebase deploy --project prod --only firestore,storage,functions",
    "publish": "npx eas-cli update --channel production --environment production --clear-cache"
  },
  "private": true
}
