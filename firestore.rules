rules_version = '2';

// Temporary rules (emulator only). Full rules + tests come in step 7.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      // On create, the server-only fields must start empty.
      allow create: if request.auth.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.verificationMethod == null
        && request.resource.data.company == null
        && request.resource.data.verifiedAt == null
        && request.resource.data.participantId == null;
      // The owner can edit their profile, but not the server-only fields.
      allow update: if request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['verified', 'verificationMethod', 'company', 'verifiedAt', 'participantId']);
    }

    match /private/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // verificationCodes: no client access (no rule = denied).
  }
}
