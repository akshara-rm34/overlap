rules_version = '2';

// Overlap security rules. Tests: tests/rules (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Full access = open full profiles and message. Verified users have it, and so does
    // everyone in the optional-verification group of the Sprint 4 A/B test.
    function hasFullAccess() {
      return signedIn()
        && (me().get('verified', false) == true || me().get('variant', null) == 'optional');
    }

    function isYmd(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- users/{uid}: public profile ----------

    // Only the server (Cloud Functions / Admin SDK) writes these.
    function serverOnlyFields() {
      return ['verified', 'verificationMethod', 'company', 'verifiedAt', 'participantId', 'variant'];
    }

    function validChecklist(c) {
      return c == null || (
        c is map
        && c.keys().hasOnly(['schedule', 'cleanliness', 'guests', 'budgetFlexible', 'stayingFullTerm'])
        && c.keys().hasAll(['schedule', 'cleanliness', 'guests', 'budgetFlexible', 'stayingFullTerm'])
        && c.schedule in ['early', 'standard', 'late']
        && c.cleanliness in [1, 2, 3, 4, 5]
        && c.guests in ['rarely', 'sometimes', 'often']
        && c.budgetFlexible is bool
        && c.stayingFullTerm in ['yes', 'probably', 'unsure']
      );
    }

    // Checks the fields the app is allowed to set, whenever they're present.
    function validProfile(d) {
      return d.keys().hasOnly([
          'displayName', 'participantId', 'city', 'startDate', 'endDate', 'budgetMin', 'budgetMax',
          'bio', 'verified', 'verificationMethod', 'company', 'verifiedAt', 'checklist',
          'checklistCompletedAt', 'housingStatus', 'variant', 'createdAt', 'updatedAt'])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 50
        && (!('city' in d) || (d.city is string && d.city.size() <= 60))
        && (!('startDate' in d) || isYmd(d.startDate))
        && (!('endDate' in d) || (isYmd(d.endDate) && d.endDate > d.startDate))
        && (!('budgetMin' in d) || (d.budgetMin is number && d.budgetMin >= 0 && d.budgetMin <= 100000))
        && (!('budgetMax' in d) || (d.budgetMax is number && d.budgetMax >= d.budgetMin && d.budgetMax <= 100000))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 280))
        && (!('housingStatus' in d) || d.housingStatus in ['search_together', 'have_place', 'either'])
        && validChecklist(d.get('checklist', null));
    }

    match /users/{uid} {
      // Your own profile, or anyone's if you have full access. Users who are still verifying
      // see the limited card copied into their match docs instead.
      allow get: if isMe(uid) || hasFullAccess();

      allow create: if isMe(uid)
        && validProfile(request.resource.data)
        && request.resource.data.verified == false
        && request.resource.data.verificationMethod == null
        && request.resource.data.company == null
        && request.resource.data.verifiedAt == null
        && request.resource.data.participantId == null
        && request.resource.data.get('variant', null) == null;

      allow update: if isMe(uid)
        && validProfile(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyFields());
    }

    // ---------- private/{uid}: owner-only ----------

    match /private/{uid} {
      allow get: if isMe(uid);

      // The app only writes here to mark an offer letter as uploaded.
      // workEmail and the review result are written by the server.
      allow create, update: if isMe(uid)
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
            .hasOnly(['offerLetterPath', 'offerLetterStatus', 'updatedAt'])
        && request.resource.data.offerLetterStatus == 'pending'
        && request.resource.data.offerLetterPath is string
        && request.resource.data.offerLetterPath.matches('^offerLetters/' + uid + '/[^/]+$');
    }

    // ---------- matches: written by computeMatches only ----------

    match /matches/{uid}/items/{otherUid} {
      allow read: if isMe(uid);
    }

    // ---------- conversations + messages ----------

    // convId is the two uids sorted and joined with "_", so it says who's in the conversation
    // even before the document exists.
    function inConv(convId) {
      return signedIn() && request.auth.uid in convId.split('_');
    }

    function otherIn(convId) {
      return convId.split('_')[0] == request.auth.uid ? convId.split('_')[1] : convId.split('_')[0];
    }

    match /conversations/{convId} {
      allow get: if inConv(convId);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;

      // Only matched people with full access can start a conversation.
      allow create: if inConv(convId)
        && hasFullAccess()
        && request.resource.data.keys().hasOnly(
            ['participants', 'overlapType', 'createdBy', 'createdAt', 'lastMessageAt',
             'lastMessageText', 'lastSenderId', 'updatedAt'])
        && request.resource.data.participants.size() == 2
        && convId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.overlapType == get(/databases/$(database)/documents/matches/$(request.auth.uid)/items/$(otherIn(convId))).data.overlapType;

      // Participants only bump the "last message" fields.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageAt', 'lastMessageText', 'lastSenderId', 'updatedAt'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 140;

      // Messages can't be edited or deleted.
      match /messages/{msgId} {
        allow read: if inConv(convId);
        allow create: if inConv(convId)
          && hasFullAccess()
          && existsAfter(/databases/$(database)/documents/conversations/$(convId))
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt == request.time;
      }
    }

    // ---------- events: create-only study log ----------

    match /events/{eventId} {
      // verify_completed, variant_assigned, and letter_reviewed are logged by the server, so the
      // app can't fake them.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'props', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name in [
            'signup', 'verify_started', 'verify_skipped', 'search', 'feed_left', 'match_shown',
            'profile_view', 'badge_tap', 'locked_message_tap', 'suggestion_shown', 'message_sent',
            'checklist_started', 'checklist_completed', 'code_fallback_shown', 'code_fallback_tap']
        && request.resource.data.props is map
        && request.resource.data.ts == request.time;
    }

    // verificationCodes and anything else: no client access.
  }
}
